{
  "profile": "STUDENT_EXAMPLE_LEG_FORCE",
  "parent_profile": "STAIRS25_V1",
  "description": "Worked example: add a graded thigh/calf contact-force penalty on top of the contact count, to target the remaining 25 cm falls after a leg catches an edge.",
  "public_sha256": "f2aa77bf0349c10ec2a00071162e37123d0cf80f3447c3989c17a618e1b24ad2",
  "fixes": {
    "actuators": true,
    "head_termination": true,
    "contact_penalties": true,
    "foot_clearance": true,
    "terrain": true,
    "commands": true
  },
  "actuators": {
    "source": "assets/go2/go2.xml motor ctrlrange (hip/thigh 23.7 Nm, calf 45.43 Nm); Go2 URDF joint velocity 30.1 / 15.7 rad/s",
    "stiffness": 25.0,
    "damping": 0.5,
    "groups": {
      "hip_thigh": {
        "joints": [
          ".*_hip_joint",
          ".*_thigh_joint"
        ],
        "effort_limit": 23.7,
        "velocity_limit": 30.1
      },
      "calf": {
        "joints": [
          ".*_calf_joint"
        ],
        "effort_limit": 45.43,
        "velocity_limit": 15.7
      }
    }
  },
  "rewards": {
    "feet_air_time_weight": 0.1,
    "leg_contact": {
      "bodies": [
        ".*_thigh",
        ".*_calf"
      ],
      "weight": -1.0,
      "threshold_N": 1.0
    },
    "feet_stumble": {
      "weight": -0.5,
      "horizontal_to_vertical_ratio": 2.0,
      "min_horizontal_force_N": 5.0
    },
    "extra_terms": [
      {
        "name": "leg_contact_force",
        "func": "go2_stairs.student_terms.examples:contact_force_excess",
        "weight": -0.002,
        "params": {
          "sensor_cfg": {
            "scene_entity": "contact_forces",
            "body_names": [
              ".*_thigh",
              ".*_calf"
            ]
          },
          "threshold": 5.0
        }
      }
    ]
  },
  "terminations": {
    "head_contact": {
      "bodies": "Head_.*",
      "threshold_N": 1.0
    }
  },
  "terrain": {
    "num_rows": 10,
    "num_cols": 20,
    "border_width_m": 30.0,
    "stair_step_height_range_m": [
      0.05,
      0.28
    ],
    "stair_step_width_m": 0.3,
    "proportions": {
      "pyramid_stairs_inv": 0.35,
      "pyramid_stairs": 0.25,
      "boxes": 0.15,
      "random_rough": 0.15,
      "hf_pyramid_slope": 0.05,
      "hf_pyramid_slope_inv": 0.05
    }
  },
  "commands": {
    "lin_vel_x": [
      -0.6,
      1.0
    ],
    "lin_vel_y": [
